direction: down

user: User question {
  shape: oval
}

auth: Dashboard session {
  shape: rectangle
}

planner: Query planner {
  shape: rectangle
  parse: Time/provider/entity hints
  intent: Needs SQL facts or stats
  filters: Build retrieval filters
}

lanes: Retrieval lanes {
  shape: rectangle

  vector: Vector lane {
    qembed: Voyage embed\ninput_type=query
    topk: vector_top_k\n40 candidates
  }

  lexical: Lexical lane {
    fts: event_fts exact terms
    ids: IDs, names, subjects
  }

  sql: SQL lane {
    facts: Provider fact tables
    exact: Counts, dates, statuses
  }

  stats: Stats lane {
    snapshots: Fresh stats snapshots
    compute: Compute if stale
  }
}

merge: Merge + rank {
  shape: rectangle
  dedupe: Dedupe by event id
  boost: Boost exact matches
  cap: Cap context budget
}

prompt: Prompt builder {
  shape: rectangle
  system: System rules
  history: Session history
  context: Source-labeled evidence
  facts: SQL facts
  signals: Stats with freshness
}

claude: Claude Sonnet 4.6 {
  shape: rectangle
}

persist: Persist assistant message {
  shape: rectangle
}

stream: Streamed answer {
  shape: oval
}

db: libSQL {
  shape: cylinder
  events: events
  vectors: event_embeddings
  ftsdb: event_fts
  factsdb: fact tables
  statsdb: stats_snapshots
  chats: chat_messages
}

user -> auth
auth -> planner.parse
planner.parse -> planner.intent
planner.intent -> planner.filters

planner.filters -> lanes.vector.qembed
planner.filters -> lanes.lexical.fts
planner.filters -> lanes.sql.facts
planner.filters -> lanes.stats.snapshots

lanes.vector.qembed -> lanes.vector.topk
lanes.vector.topk -> db.vectors
lanes.lexical.fts -> db.ftsdb
lanes.sql.facts -> db.factsdb
lanes.stats.snapshots -> db.statsdb
lanes.stats.snapshots -> lanes.stats.compute: stale or missing
lanes.stats.compute -> db.statsdb

db.vectors -> merge.dedupe
db.ftsdb -> merge.dedupe
db.factsdb -> merge.dedupe
db.statsdb -> merge.dedupe

merge.dedupe -> merge.boost
merge.boost -> merge.cap
merge.cap -> prompt.context
db.chats -> prompt.history
prompt -> claude: AI SDK streamText
claude -> stream
stream -> persist
persist -> db.chats
