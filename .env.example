# Required — internal PostgreSQL credentials (docker-compose builds DATABASE_URL from them).
# The image is pgvector/pgvector:pg16, not plain postgres: the migration enables the
# vector extension at startup and a stock postgres image cannot.
POSTGRES_USER=perception
POSTGRES_PASSWORD=perception-internal-db
# POSTGRES_DB=perception

# Optional — override only outside docker-compose, which builds this itself
# DATABASE_URL=postgres://perception:perception@localhost:5432/perception?sslmode=disable

# Optional — deployment name: development, staging, production
# APP_ENV=production

# Optional — API listen port
# PORT=4000

# Optional — debug, info, warn, error
# LOG_LEVEL=info

# Optional — comma-separated CORS origins. Unset denies every cross-origin caller,
# which is what the single-container deployment wants: the Go binary serves the SPA,
# so the client is same-origin. "*" is refused at startup because the API sends
# credentials. docker-compose defaults it to the public host, which also seeds
# OIDC_SUCCESS_URL when that is left empty.
# CORS_ALLOWED_ORIGINS=https://perception.facile.studio

# Optional — public origin used to build links that leave the server. Defaults to the
# first CORS_ALLOWED_ORIGINS entry, which is what docker-compose already sets, so most
# deployments never touch this.
# PUBLIC_URL=https://perception.facile.studio

# Emails allowed to act as administrators. Empty means nobody is — admin-only
# behaviour fails closed rather than defaulting to the first user who registers.
PERCEPTION_ADMIN_EMAILS=

# OIDC against Porte, the suite's Authentik instance (optional — leave empty to use
# email/password auth). SSO_ONLY=true removes /api/auth/login and /api/auth/register
# entirely, so set it only once the OIDC round trip is known to work: there is no
# local password left to fall back to.
# OIDC_ISSUER=https://porte.facile.studio/application/o/perception/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://perception.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://perception.facile.studio
# SSO_ONLY=false

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL
# http://journal-api:4010/api on la ruche). The URL must end in /api. Unset means logs
# stay on stdout only.
# JOURNAL_URL=http://journal-api:4010/api
# JOURNAL_TOKEN=journal_perception_...

# Reserved for later phases — NOT read by the code yet. They are listed here so the
# ingest and embedding work lands in a known place instead of inventing new names:
# INGEST_HMAC_SECRET signs the Antenne ingest endpoint and is read as of phase one: without
# it every delivery is refused with no_ingest_secret_configured, and the API says so at boot.
# It must be the same value as Antenne's Perception delivery target secret. PREVIOUS exists
# only so a rotation does not need both sides restarted in the same second.
INGEST_HMAC_SECRET=
# INGEST_HMAC_SECRET_PREVIOUS=
# INGEST_MAX_SKEW_SECONDS=300

# ANTHROPIC_API_KEY is the chat model and VOYAGE_API_KEY the embedding model, neither read
# yet. The old note claimed the ingest secrets were reserved too; they are not, so a
# secret can be rotated without dropping in-flight events.
# ANTHROPIC_API_KEY=
# VOYAGE_API_KEY=
